-lemma Hopt_tautology_suspect: "ALL q. H_opt q"
-  nitpick [card U=3, timeout=20, expect = genuine] oops
-
-lemma Comparable_PDom_on_tautology_suspect: "ALL q. Comparable_PDom_on q"
