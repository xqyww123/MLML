-lemma Nitpick_n1_global_exclusion_core:
-  assumes "\<exists>a a' b c.
-            EDia b \<and> EDia c \<and>
-            (Arg b) \<preceq> (Arg a) \<and> (Arg c) \<preceq> (Arg a) \<and>
-            (\<not> ((Arg b) \<preceq> (Arg a')) \<or> \<not> ((Arg c) \<preceq> (Arg a'))) \<and>
-            EH (Arg a')"
