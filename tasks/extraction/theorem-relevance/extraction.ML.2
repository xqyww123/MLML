val REPAIR_MODE = true
val ac_shuffle_num = 40

type defctxt = string
type goal = string list * string
type thm_expr = string
type premise_group_old = goal * (thm_expr list * goal list (*ac-shuffle*))
type premise_group = goal * (defctxt * thm_expr list * goal list (*ac-shuffle*))

val goal_eq = eq_pair (eq_set (op =)) (op =)

type transformed = bool (*tranformed or original*)
type proof_id = int
type position' = Position.T * transformed * proof_id
type reporter = {
        start: Position.T -> bool,
        start_SH: Position.T -> transformed -> proof_id -> bool,
        premise_group: Position.T
                    -> premise_group list
                    -> unit,
        premise_group': position'
                    -> premise_group list
                    -> unit,
        notify_theorems: Proof.context -> (thm_expr * (defctxt * thm)) list -> unit,
        report_errors : string list -> unit,
        debug: string list -> unit,

        repair_ctxtinfo : Proof.context -> Position.T -> bool,
        repair_ctxtinfo': Proof.context -> position' -> bool
     }

val _ = MinLang_Translator.msorry_printing :=
          "tactic \<open>ALLGOALS (Skip_Proof.cheat_tac \<^context>)\<close>"

fun is_goal_command (Command_Span.Command_Span (name, _)) =
      member (op =) ["lemma", "theorem", "schematic_goal", "proposition", "corollary",
                     "interpretation", "global_interpretation", "sublocale"] name
  | is_goal_command _ = false
fun is_goal_command' (Command_Span.Span (k, _)) = is_goal_command k

fun print_term_ ctxt =
    let val ctxt' = ctxt
              |> Config.put Printer.show_types true
              |> Config.put Printer.show_sorts true
              (* |> Config.put Printer.show_question_marks false *)
     in Syntax.string_of_term ctxt'
     #> REPL.trim_makrup
    end

fun pos_packer pos =
  let open MessagePackBinIO.Unpack MessagePackBinIO.Pack
      val {line, offset, end_offset, props} = Position.dest pos
      val {label, file, id} = props
   in packTuple4 (packInt, packInt, packInt, packTuple3 (packString, packString, packString))
      (line, offset, end_offset, (label, file, id))
  end

val known_premises = Synchronized.var "Theorem_Extraction.known_premises" Symtab.empty

fun hotfix_underscore s =
  if Char.contains s #"_" then
  let fun pass [] = []
        | pass (c :: #"_" :: s) =
            if Char.isAlphaNum c
            then c :: #"_" :: #"x" :: pass s
            else c :: #"_" :: pass s
        | pass (c :: s) = c :: pass s
   in String.implode (pass (String.explode s))
  end
  else s

fun repair_ctxtinfo ctxt =
  let val ctxt = Proof_Context.set_mode Proof_Context.mode_schematic ctxt
      val defctxt_of = Context_Info.defctxt_string_of ctxt
      fun work ((goal_o, (thms_o, goal_acs_o)), ((goal, (_, _)) : premise_group_old)) : premise_group =
        let val goal_defctxt =
            let val (hs, cl) = goal
                val hs' = map (Syntax.read_term ctxt o hotfix_underscore) hs
                val cl' = Syntax.read_term ctxt (hotfix_underscore cl)
                val prop = Logic.list_implies (hs', cl')
             in defctxt_of prop
            end
         in (goal_o, (goal_defctxt, thms_o, goal_acs_o))
        end
   in work
  end

fun socket_reporter pos_tr (cin,cout) =
  let open MessagePackBinIO.Unpack MessagePackBinIO.Pack
   (* val packError  = packString o Minilang_Aux.trim_markup o String.concat o Runtime.exn_message_list
      val packErrors = packList packError *)
      val pos_packer = pos_packer o pos_tr
      val pos_packer' = packTuple3 (pos_packer, packBool, packInt)
      fun read packer = let val (ret, cin') = doUnpack packer (!cin)
                         in cin := cin'
                          ; ret
                        end
      val pack_goal = packPair (packList packString, packString)
      val unpack_goal = unpackPair (unpackList unpackString, unpackString)
      val pack_defctxt = packString
      val unpack_defctxt = unpackString
      val printer_locker = Synchronized.var "" ()

      val unpack_premise_group_old =
            unpackPair (unpack_goal,
                        unpackPair (
                          unpackList unpackString,
                          unpackList unpack_goal))
      val pack_premise_group = packPair (
                        pack_goal,
                        packTuple3 (
                          pack_defctxt,
                          packList packString,
                          packList pack_goal))
      (* fun debug errs = Synchronized.change printer_locker (fn () => (
              doPack (packPair (packInt, packList packString)) (9, errs) cout
            ; BinIO.StreamIO.flushOut cout )) *)
      val debug = K ()

      fun send packer data = (
              doPack packer data cout
            ; BinIO.StreamIO.flushOut cout)

   in { start = (fn pos =>
          let val _ = doPack (packPair (packInt, pos_packer)) (0, pos) cout 
              val _ = BinIO.StreamIO.flushOut cout
           in read unpackBool
          end),
        start_SH = (fn pos => fn transformed => fn pid => (
            doPack (packTuple4 (packInt, pos_packer, packBool, packInt))
                   (6, pos, transformed, pid) cout
          ; BinIO.StreamIO.flushOut cout
          ; read unpackBool)),
        premise_group = (fn pos => fn data => (
          doPack (packTuple3 (packInt, pos_packer, packList pack_premise_group))
                 (1, pos, data)
                 cout
        ; BinIO.StreamIO.flushOut cout
        )),
        premise_group' = (fn pos => fn data => (
          doPack (packTuple3 (packInt, pos_packer', packList pack_premise_group))
                 (7, pos, data)
                 cout
        ; BinIO.StreamIO.flushOut cout
        )),
        notify_theorems = (fn ctxt => fn premises =>
          Synchronized.change known_premises (fn tabs =>
          let val premises' = filter_out (Symtab.defined tabs o fst) premises
              val _ = doPack (packPair (packInt, packList packString))
                             (2, map fst premises') cout
              val _ = BinIO.StreamIO.flushOut cout
              val seen = read (unpackList unpackString)
              val print = print_term_ ctxt
              val get_ac = ac_shuffle ac_shuffle_num (Context.Proof ctxt)
              fun pass thm = map print (get_ac (Thm.prop_of thm))
              val premises'1 = filter_out (member (op =) seen o fst) premises'
                            |> map (apsnd (apsnd pass))
           in doPack (packPair (packInt,
                    packPairList (packString, packPair (pack_defctxt, packList packString)))
                ) (3, premises'1) cout
            ; BinIO.StreamIO.flushOut cout
            ; fold (Symtab.update o rpair ()) seen tabs
          end )),
        report_errors = (fn errs => (
              doPack (packPair (packInt, packList packString)) (4, errs) cout
            ; BinIO.StreamIO.flushOut cout )),
        debug = K () (* (fn errs => Synchronized.change printer_locker (fn () => (
              doPack (packPair (packInt, packList packString)) (9, errs) cout
            ; BinIO.StreamIO.flushOut cout ))) *),

        repair_ctxtinfo = (fn ctxt0 => 
          let val repair_ctxtinfo = repair_ctxtinfo ctxt0
              val ctxt = Proof_Context.set_mode Proof_Context.mode_schematic ctxt0
              val defctxt_of = Context_Info.defctxt_string_of ctxt
           in fn pos =>
          let val _ = debug ["Enter repair_ctxtinfo", the (Position.file_of pos)]
              val _ = send (packPair (packInt, pos_packer)) (17, pos)
              val mode = read unpackBool
              val _ = debug [if mode then "mode true" else "mode false"]
           in if mode
            then true
            else \<^try>\<open>
          let val _ = send (packPair (packInt, pos_packer)) (11, pos)
              val old_data = read (unpackOption (unpackList (unpackPair (unpack_premise_group_old, unpack_premise_group_old))))
              val _ = debug ["11 OK"]
              val old_data = case old_data of SOME x => x | NONE => error "data not exists"
              val new_data = map repair_ctxtinfo old_data
           in Synchronized.change known_premises (fn tabs =>
              let val premises = maps (#2 o snd) new_data
                  val premises' = filter_out (Symtab.defined tabs) premises
                  val _ = debug ["before 2"]
                  val _ = send (packPair (packInt, packList packString)) (2, premises')
                  val seen = read (unpackList unpackString)
                  val _ = debug ["2 OK"]
                  val premises'1 = filter_out (member (op =) seen) premises'

                  val defctxts = map (fn expr =>
                        let val prop = Syntax.read_term ctxt (hotfix_underscore expr)
                         in defctxt_of prop
                        end ) premises'1

                  val _ = debug ["before 13"]
                  val _ = send (packPair (packInt, packList packString)) (13, premises'1)
                  val acs = read (unpackList (unpackOption (unpackList unpackString)))
                         |> map (fn SOME x => x | NONE => error "no AC")
                  val _ = debug ["13 OK"]
                  

                  val data' = premises'1 ~~ (defctxts ~~ acs)
                  
               in send (packPair (packInt,
                      packPairList (packString, packPair (pack_defctxt, packList packString)))
                  ) (3, data')
                ; fold (Symtab.update o rpair ()) seen tabs
              end )
            ; send (packTuple3 (packInt, pos_packer, packList pack_premise_group)) (1, pos, new_data)
            ; debug ["repair succeess"]
            ; false
          end catch err => (debug ["AAAA", Runtime.exn_message err]; true)\<close>
          end end ),

        repair_ctxtinfo' = (fn ctxt0 => 
          let val repair_ctxtinfo = repair_ctxtinfo ctxt0
              val ctxt = Proof_Context.set_mode Proof_Context.mode_schematic ctxt0
              val defctxt_of = Context_Info.defctxt_string_of ctxt
           in fn pos => \<^try>\<open>
          let val _ = send (packPair (packInt, pos_packer')) (14, pos)
              val old_data = read (unpackOption (unpackList (unpackPair (unpack_premise_group_old, unpack_premise_group_old))))
              val _ = debug ["14 OK"]
              val old_data = case old_data of SOME x => x | NONE => error "data not exists"
              val new_data = map repair_ctxtinfo old_data
           in Synchronized.change known_premises (fn tabs =>
              let val premises = maps (#2 o snd) new_data
                  val premises' = filter_out (Symtab.defined tabs) premises
                  val _ = debug ["before 2"]
                  val _ = send (packPair (packInt, packList packString)) (2, premises')
                  val seen = read (unpackList unpackString)
                  val _ = debug ["2 OK"]
                  val premises'1 = filter_out (member (op =) seen) premises'

                  val defctxts = map (fn expr =>
                        let val prop = Syntax.read_term ctxt (hotfix_underscore expr)
                         in defctxt_of prop
                        end ) premises'1

                  val _ = debug ["before 13"]
                  val _ = send (packPair (packInt, packList packString)) (13, premises'1)
                  val acs = read (unpackList (unpackOption (unpackList unpackString)))
                         |> map (fn SOME x => x | NONE => error "no AC")
                  val _ = debug ["13 OK"]
                  

                  val data' = premises'1 ~~ (defctxts ~~ acs)
                  
               in send (packPair (packInt,
                      packPairList (packString, packPair (pack_defctxt, packList packString)))
                  ) (3, data')
                ; fold (Symtab.update o rpair ()) seen tabs
              end )
            ; send (packTuple3 (packInt, pos_packer', packList pack_premise_group)) (7, pos, new_data)
            ; debug ["inner repair succeess"]
            ; false
          end catch err => (debug ["BBBBB", Runtime.exn_message err]; true)\<close>
          end)
    } : reporter
  end


fun concatWith x LL = List.concat (map_index (fn (0,L) => L | (_,L) => x @ L) LL)

val (interactive_reporter : reporter) = let open Pretty
     fun print_goal (assms, concl) =
          concatWith [str ", ", brk 1] (map text assms) @ str " |-" :: brk 1 :: text concl
  in {
    start = (fn pos => (
      tracing (string_of (block [str "Start ", position pos])) ;
      true
    )),
    start_SH = (fn pos => fn tr => fn i => (
      tracing (string_of (block [
          str "Start ",
          position pos,
          str (if tr then " transformed " else " original "),
          str (string_of_int i) ])) ;
      true
    )),
    premise_group = (fn pos => fn data =>
      tracing (string_of (chunks (
            block [str "Position:", brk 1, position pos]
         :: map (fn (goal, (_, thms, acs)) =>
              item [chunks [
                  block (print_goal goal)
                , str "Dependent theorems"
                , chunks (map (item o text) thms) 
                , str "AC shuffle"
                , chunks (map (item o print_goal) acs)
                  ]]) data
         )))),
    premise_group' = (fn (pos, transformed, ID) => fn data =>
      tracing (string_of (chunks (
            block [str "Position:", brk 1, position pos,
                   str (if transformed then " transformed " else " original "),
                   str (string_of_int ID) ]
         :: map (fn (goal, (_, thms, acs)) =>
              item [chunks [
                  block (print_goal goal)
                , str "Dependent theorems"
                , chunks (map (item o text) thms) 
                , str "AC shuffle"
                , chunks (map (item o print_goal) acs)
                  ]]) data
         )))),
    notify_theorems = (fn ctxt => fn thms =>
      tracing (string_of (chunks (
          para "New theorem(s):"
       :: map (fn (_, (_, th)) =>
            item [Syntax.pretty_term ctxt (Thm.prop_of th)]
          ) thms )))),
    report_errors = (fn errs =>
      warning (string_of (chunks (map para errs))) ),
    debug = (fn info =>
      warning (string_of (chunks (map para info))) ),
    repair_ctxtinfo = (fn _ => fn _ => true),
    repair_ctxtinfo'= (fn _ => fn _ => true)
    }
  end

exception Partial_Ret of
    ((string list * string) *
     (string * (string * (string * thm)) list *
      (string list * string) list)
    ) list

fun join_entry ((c,pa,ga), (_,pb,gb)) = (c, AList.join (op =) (K fst) (pa, pb), union (op =) ga gb)

val single_cmd_timeout = Time.fromSeconds 60
fun raw_collect (report_err, debug, can_start, notify) first_goal_or_all stat commands =
  let open Minilang_Aux
      val can_start = can_start first_goal_or_all
      val notify = notify first_goal_or_all
      fun extraction _ _ ret [] = ret
        | extraction ID stat ret (all_commands as (tr, _) :: commands) =
            let fun fallback () =
                     case try (Timeout.apply single_cmd_timeout (Toplevel.command_errors true tr)) stat
                       of SOME ([], SOME stat') => extraction (ID+1) stat' ret commands
                        | _ => error "BUG extraction_thor - Isar evaluation fails"
                fun collect_premises ret commands =
                  let (* val ctxt = Toplevel.context_of stat
                     val sequent = #goal (Proof.goal (Toplevel.proof_of stat)) *)

                     val tactics = extract_proof all_commands
                     val origin_prf = tactics
                                   |> map ( filter Token.is_proper
                                          o Command_Span.content o snd)
                     val origin_ast = try MinLang_Translator.parse_isar_no_state origin_prf
                     fun pass stat ret [] _ = (stat, ret)
                       | pass stat ret all_cmds all_ast =
                          let val ctxt = Toplevel.context_of stat
                              fun get_premises () =
                                let val defctxt_string_of = Context_Info.defctxt_string_of ctxt
                                 (* val thy = Proof_Context.theory_of ctxt *)
                                    val (override, wthms) = case all_ast
                                          of SOME ast => let
                                              val (w,_) = MinLang_Translator.collect_facts ast
                                              val override = { add = w, del = [], only = false }
                                              val wthms = Attrib.eval_thms ctxt w
                                           in (override, wthms)
                                          end
                                           | NONE => ({ add=[], del=[], only=false }, [])
                                    val _ = debug ["Before run premise selection"]
                                    val premises =
                                          \<^try>\<open>premise_selection debug first_goal_or_all wthms override stat
                                            catch E => (report_err (Runtime.exn_message_list E) ; [])\<close>
                                    val _ = debug ["After premise selection"]
                                    val print = print_term_ ctxt
                                    fun print_goal (assms, goal) = (map print assms, print goal)
                                    val get_acs = ac_shuffle_goal ac_shuffle_num (Context.Proof ctxt)
                                    val assms = Assumption.all_assms_of (Toplevel.context_of stat)
                                             |> map Thm.term_of
                                 in premises
                                 |> map (fn (goal, prems) =>
                                      let val prop = Logic.list_implies (assms, goal)
                                       in ( (map print assms, print goal),
                                            ( defctxt_string_of prop,
                                              map (fn prem =>
                                                let val prop = Thm.prop_of prem
                                                 in (print prop, (defctxt_string_of prop, prem))
                                                end ) prems,
                                              map print_goal (get_acs (assms, goal))))
                                      end )
                                end
                              val do_SH = can_start (ctxt, ID)
                              val ret' = if do_SH
                                         then let val premises = get_premises ()
                                               in notify ID premises
                                                ; AList.join goal_eq (K join_entry) (premises, ret)
                                              end
                                         else ret
                              fun move_next state ((tr, Command_Span.Span (kind, _)) :: cmds) asts =
                                    let val (stat', err) =
                                            case try (Timeout.apply single_cmd_timeout (Toplevel.transition false tr)) state
                                              of SOME ret => ret
                                               | NONE => raise Partial_Ret ret'
                                        val _ = case err of NONE => ()
                                                  | SOME (E, _) => (
                                                      report_err (Runtime.exn_message_list E)
                                                    ; raise Partial_Ret ret')
                                        val asts' = Option.map (fn _ :: L => L | [] => []) asts
                                     in case kind
                                          of Command_Span.Command_Span ("using", _) =>
                                                move_next stat' cmds asts'
                                           | _ => (stat', cmds, asts')
                                    end
                                | move_next _ _ _ = error "BUG: extraction.collect_premises.pass"
                              val _ = debug ["Before move_next"]
                              val (stat', cmds', asts') = move_next stat all_cmds all_ast
                              val _ = debug ["After move_next"]
                           in pass stat' ret' cmds' asts'
                          end
                      val _ = case origin_ast
                           of SOME ast =>
                              if length ast = length commands
                              then ()
                              else error "BUG: raw_collect.extraction"
                            | _ => ()
                   in pass stat ret commands origin_ast
                  end
             in (*
            if unsuported span
            then raise Unsupported "oops or sorry"
            else *) if Toplevel.is_proof stat andalso
                       begin_with_tactic all_commands
            then let val tactics = extract_tactic all_commands
                     val (stat', ret') =
                        \<^try>\<open>collect_premises ret tactics
                          catch Partial_Ret ret => raise Partial_Ret ret
                              | E => (
                                    report_err (Runtime.exn_message_list E);
                                    raise Partial_Ret ret )\<close>
                  (* val pos = case Command_Span.kind (snd (hd tactics))
                                 of Command_Span.Command_Span (_, pos) => pos
                                  | _ => error "BUG" *)
                  in \<^try>\<open>extraction (ID+1) stat' ret' (remove_tactic all_commands)
                      catch Partial_Ret ret => raise Partial_Ret ret
                          | E => ( report_err (Runtime.exn_message_list E);
                                   raise Partial_Ret ret )\<close>
                 end
            else fallback ()
            end
   in debug ["Start collection"]
    ; extraction 0 stat [] commands
  end

fun parse_cmds thy src =
  let val pos = Position.make {
                  line=1, offset=1, end_offset=1,
                  props= { label = "", file = "#Extraction", id="" }
                }
      val symbs = Symbol_Pos.explode (src, pos)
      val keywords = Thy_Header.get_keywords thy
                  |> Keyword.add_major_keywords ["mqed", "mproof"]
      fun fix_cmds (_, cmd as Command_Span.Span (Command_Span.Command_Span ("mproof", pos), _))
            = ( MinLang_Translator.mproof_transition Toplevel.empty
                  |> Toplevel.position pos
                  |> Toplevel.name "mproof"
              , cmd)
        | fix_cmds (_, cmd as Command_Span.Span (Command_Span.Command_Span ("mqed", pos), _))
            = ( MinLang_Translator.mqed_transition Toplevel.empty
                  |> Toplevel.position pos
                  |> Toplevel.name "mqed"
              , cmd)
        | fix_cmds x = x
      val cmds = Token.tokenize keywords {strict = false} symbs
              |> Outer_Syntax.parse_spans
              |> map (` (Command_Span.content #> Outer_Syntax.parse_span thy (K thy)))
              |> filter_out (Toplevel.is_ignored o fst)
              |> map fix_cmds
   in cmds
  end

fun collect (channels as (report_err, debug, _, _)) stat commands =
  let val stat' = stat
      fun try_raw_collect flag stat commands =
          \<^try>\<open>raw_collect channels flag stat commands
            catch Partial_Ret ret => ret
                | E => ( report_err (Runtime.exn_message_list E); [] )\<close>
   in case try (fn () =>
        let val _ = debug ["start elaboration"]
            val tokens = map (filter Token.is_proper o Command_Span.content o snd) commands
            val ast' = MinLang_Translator.elaborate (Unsynchronized.ref []) (stat, tokens)
            val elaborated = MinLang_Translator.print_ast ast'
            val thy = Toplevel.theory_of stat'
            val cmds' = parse_cmds thy elaborated
            val _ = Timeout.apply (Time.fromSeconds (60 + 20 * length cmds'))
                                  (fold (Toplevel.command_exception false o fst) cmds') stat'
         in debug ["Elaboration succeeds", elaborated]
          ; cmds'
        end) ()
    of SOME cmds' =>
          \<^try>\<open>raw_collect channels true stat' cmds'
            catch Partial_Ret ret =>
              let val ret0 = try_raw_collect false stat commands
               in AList.join goal_eq (K join_entry) (ret0, ret)
              end
                | E => ( report_err (Runtime.exn_message_list E);
                         try_raw_collect false stat commands )\<close>
     | NONE => try_raw_collect false stat commands
  end

