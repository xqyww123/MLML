val extract_proof =
  let datatype ele = FWD | BWD
      fun pop _ [] = error "Malformed Source"
        | pop k (k'::SK) = if k = k' then SK else error "Malformed Source"
      fun pass [] _ = []
        | pass stack ((tr, sp as Command_Span.Span (Command_Span.Command_Span (name, _), _)) :: L)
            = (case name
                 of "proof" => (tr, sp) :: pass (FWD :: stack) L
                  | "qed"   => (tr, sp) :: pass (stack |> pop FWD |> pop BWD) L
                  | "have"  => (tr, sp) :: pass (BWD :: stack) L
                  | "show"  => (tr, sp) :: pass (BWD :: stack) L
                  | "hence" => (tr, sp) :: pass (BWD :: stack) L
                  | "thus"  => (tr, sp) :: pass (BWD :: stack) L
                  | "consider"  => (tr, sp) :: pass (BWD :: stack) L
                  | "obtain"    => (tr, sp) :: pass (BWD :: stack) L
                  | "interpret" => (tr, sp) :: pass (BWD :: stack) L
                  | "subgoal"   => (tr, sp) :: pass (BWD :: stack) L
                  | "by"    => (tr, sp) :: pass (pop BWD stack) L
                  | "done"  => (tr, sp) :: pass (pop BWD stack) L
                  | "apply_end" => (tr, sp) :: pass (pop BWD stack) L
                  | "."     => (tr, sp) :: pass (pop BWD stack) L
                  | ".."    => (tr, sp) :: pass (pop BWD stack) L
                  |  _      => (tr, sp) :: pass stack L
              )
        | pass _ _ = error "Malformed Source"
   in pass [BWD]
  end

fun REPL_plugin (reporter : reporter) : REPL.collector =
      fn _ => fn {current_command, state, remaining} =>
  let val pos = case current_command of Command_Span.Span (Command_Span.Command_Span (_, pos), _) => pos
                   | _ => Position.none
   in if is_goal_command' current_command andalso
        Toplevel.is_proof state andalso
         let val st = #goal (Proof.raw_goal (Toplevel.proof_of state))
          in not (Thm.is_dummy st) andalso not (Thm.no_prems st)
         end
    then if ( if REPAIR_MODE
              then \<^try>\<open>let
                   val proof = extract_proof remaining
                   val has_define = exists (fn (_, Command_Span.Span (Command_Span.Command_Span (name, _), _)) =>
                              name = "define"
                            | _ => false) proof
                in #debug reporter ["ENTER1", the (Position.file_of pos), string_of_int (the (Position.line_of pos))]
                 ; (if has_define then #debug reporter ["Has define"]
                   else ())
                 ; #start reporter pos andalso (
                   has_define orelse
                   #repair_ctxtinfo reporter (Toplevel.context_of state) pos )
               end catch err => (#debug reporter ["EEE1", Runtime.exn_message err]; true)\<close>
              else #start reporter pos )
      then let
          val proof = Minilang_Aux.extract_proof remaining
          val ctxt = Toplevel.context_of state
          fun notify data =
            let val premise_group = map (apsnd (ap23 (map fst))) data
                val theorems = maps (#2 o snd) data
             in #premise_group reporter pos premise_group
              ; #notify_theorems reporter ctxt theorems
            end
          fun notify' transformed ID data =
            let val premise_group = map (apsnd (ap23 (map fst))) data
                val theorems = maps (#2 o snd) data
             in #premise_group' reporter (pos, transformed, ID) premise_group
              ; #notify_theorems reporter ctxt theorems
            end
          val data = collect ( #report_errors reporter,
                               #debug reporter,
                               (fn transformed => fn (ctxt, ID) =>
                                  if REPAIR_MODE
                                  then #start_SH reporter pos transformed ID andalso
                                       #repair_ctxtinfo' reporter ctxt (pos, transformed, ID)
                                  else #start_SH reporter pos transformed ID ),
                               notify' )
                             state proof
       in notify []
        ; (NONE, NONE)
      end
      else (NONE, NONE)
    else (NONE, NONE)
  end

fun init_translator reporter = (
      REPL.init_repler NONE
    ; REPL.set_register_thy false
    ; REPL.register_plugin ("Theorem_Extraction", REPL_plugin reporter) )

exception Bad_Source of string list

fun extraction_src cfg src =
  let val errs = REPL.collect_erros (REPL.RE cfg src)
   in if null errs
    then ()
    else raise Bad_Source errs
  end

fun extraction_file path =
  let val path' = Path.explode path
      val thy_qualifier = the_default "HOL" (REPL_Aux.parse_session_name path')
      val src = File.read path'
      val dir = Path.dir path'
   in extraction_src { thy_qualifier = thy_qualifier,
                      file = SOME path,
                      position_label = NONE,
                      additional_libs = [] (*["Minilang.Minilang_Base"]*),
                      import_dir = NONE,
                      single_cmd_timeout = NONE,
                      attributes = [],
                      base_dir = dir,
                      write_thy = false }
                    src
  end

fun extract_source state src =
  let val thy = Toplevel.theory_of state
      val cmds = parse_cmds thy src
      val result = Unsynchronized.ref []
      fun notify _ _ data = result := data @ !result
   in collect ((fn errs => warning (String.concatWith "\n" errs)),
               (fn errs => warning (String.concatWith "\n" errs)),
               (fn  _ => fn _ => true),
               notify
              ) state cmds
  end



fun REPL_App (cin, cout, toplevel) =
  let open MessagePackBinIO.Unpack MessagePackBinIO.Pack
      fun read packer = let val (ret, cin') = doUnpack packer (!cin)
                         in cin := cin'
                          ; ret
                        end
      val path = read unpackString

      val path' = Path.explode path
      val src = File.read path'
      val (_, tr) = REPL_Aux.column_of_pos src
      val reporter = socket_reporter tr (cin,cout)

   in init_translator reporter
    ; \<^try>\<open>extraction_file path
        catch Bad_Source errs => #report_errors reporter errs \<close>
    ; doPack packInt 5 cout
    ; BinIO.StreamIO.flushOut cout
    ; toplevel
  end

val _ = REPL_Server.register_app "Premise_Extraction" REPL_App

end
